# Copy to .env and explicitly configure. No runnable default credentials.
ETL_ENVIRONMENT=development
ETL_DATABASE_URL=
ETL_REDIS_URL=
ETL_ALLOWED_ORIGINS=["http://localhost:5173"]
# Local HTTP development only; production requires Secure and HTTPS origins.
ETL_COOKIE_SECURE=false
ETL_SESSION_KEY=
ETL_CURSOR_KEY=
ETL_CAPABILITY_PRIVATE_KEY=
ETL_CAPABILITY_PUBLIC_KEYS={}
ETL_CAPABILITY_KEY_ID=default
ETL_CLASSIFICATION_RISKS={}
ETL_PROJECT_MANAGERS={}
ETL_MODEL_PROVIDERS={}
ETL_ENDPOINT_ALLOWLIST=[]
ETL_PROBE_CONNECTORS=[]
ETL_SECRET_PROVIDER_URL=
ETL_SECRET_PROVIDER_TOKEN=
# Runtime data plane stays blocked until verified adapters are connected.
ETL_SEATUNNEL_CAPABILITIES=[]
